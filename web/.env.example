# Local web app settings. Compose overrides DB_HOST and ML_SERVICE_URL.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-the-mysql-root-password
DB_NAME=smart_electricity
ML_SERVICE_URL=http://localhost:8000
